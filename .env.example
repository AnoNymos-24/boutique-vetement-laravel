APP_NAME="INA SHOP"
# local en développement ; production sur le serveur de mise en ligne.
APP_ENV=local
APP_KEY=
# À mettre impérativement à false en production — sinon toute erreur affiche
# la stack trace complète (chemins serveur, requêtes SQL) à n'importe qui.
APP_DEBUG=true
# Doit correspondre exactement à l'URL réelle du site (protocole + domaine) :
# une valeur incorrecte casse les liens absolus (images, e-mails, redirections).
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Le projet est développé et déployé sur MySQL (pas SQLite).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=projet_ina
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# À mettre à true une fois le site servi en HTTPS (production) — sinon le
# cookie de session peut être transmis en clair.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Ces réglages ne servent qu'en dernier recours (avant la première connexion
# admin, ou si la base est inaccessible) : une fois l'admin connecté, l'envoi
# réel des e-mails (commandes, avis, réclamations...) passe par les identifiants
# saisis dans Paramètres → E-mail, stockés en base (table store_settings),
# PAS par ces variables. MAIL_MAILER=log écrit les mails dans storage/logs
# au lieu de les envoyer — pratique en local, à ne jamais garder en production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Les numéros Wave / Orange Money et l'activation du paiement à la livraison
# se configurent aussi dans l'admin (Paramètres → Paiement), jamais ici.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
